# --- Model provider ---------------------------------------------------
# Any OpenAI-compatible API. Pick one block.

# Google Gemini (free tier, no card needed - https://aistudio.google.com/apikey)
LLM_API_KEY=your-gemini-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.6-flash

# OpenAI (leave LLM_BASE_URL unset)
# LLM_API_KEY=sk-your-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini

# Pin an explicit model version. Aliases like gemini-flash-latest can move to a
# reasoning model that takes 45s+ per answer.

# Shorter embeddings halve storage and the per-query dot product.
# gemini-embedding-001 defaults to 3072 and supports truncation to 1536 / 768.
# Not every model accepts this - leave unset to use the model default.
EMBEDDING_DIMENSIONS=1536

# --- Storage ----------------------------------------------------------
DB_PATH=knowledge_inbox.db

# --- Chunking ---------------------------------------------------------
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# --- Retrieval --------------------------------------------------------
RETRIEVAL_TOP_K=5
# Cosine score below which a chunk is treated as irrelevant.
# Measured, not guessed: gemini-embedding-001 floors near 0.40 on completely
# unrelated text and reaches 0.70+ on genuine matches, so 0.60 sits in the gap.
# A different embedding model needs this re-measured.
SIMILARITY_THRESHOLD=0.60

# --- URL ingestion ----------------------------------------------------
URL_FETCH_TIMEOUT_SECONDS=10
MAX_CONTENT_CHARS=200000
# Below this many characters of extracted text, a page is treated as having no
# article on it. Index and aggregator pages yield a headline plus a one-line
# teaser, which would otherwise be stored as a healthy item that answers
# nothing. Notes are exempt - a two-word note is legitimate.
MIN_EXTRACTED_CHARS=500
